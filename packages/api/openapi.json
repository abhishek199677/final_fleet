  "info": {
    "title": "Fleet OS API",
    "description": "Multi-tenant SaaS for heavy-equipment operators",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "CreateTenantDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Acme Equipment"
          },
          "slug": {
            "type": "string",
            "example": "acme"
          },
          "country": {
            "type": "string",
            "example": "NG"
          },
          "base_currency": {
            "type": "string",
            "example": "NGN"
          },
          "timezone": {
            "type": "string",
            "example": "Africa/Lagos"
          }
        },
        "required": [
          "name",
          "slug",
          "country",
          "base_currency"
        ]
      },
      "CreateMachineDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "EXC-001"
          },
          "type": {
            "type": "string",
            "example": "excavator"
          },
          "make": {
            "type": "string",
            "example": "Caterpillar"
          },
          "model": {
            "type": "string",
            "example": "320F"
          },
          "year": {
            "type": "number",
            "example": 2020
          },
          "chassis_no": {
            "type": "string"
          },
          "primary_meter_type": {
            "type": "string",
            "example": "hours"
          },
          "meter_unit_label": {
            "type": "string",
            "example": "hours"
          },
          "client_uuid": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "type",
          "primary_meter_type",
          "meter_unit_label",
          "client_uuid"
        ]
      },
      "CreateWorkSessionDto": {
        "type": "object",
        "properties": {
          "machine_id": {
            "type": "string"
          },
          "deployment_id": {
            "type": "string"
          },
          "operator_id": {
            "type": "string"
          },
          "helper_id": {
            "type": "string"
          },
          "start_at": {
            "type": "string"
          },
          "end_at": {
            "type": "string"
          },
          "start_meter": {
            "type": "number"
          },
          "end_meter": {
            "type": "number"
          },
          "units_run": {
            "type": "number"
          },
          "start_photo_key": {
            "type": "string"
          },
          "end_photo_key": {
            "type": "string"
          },
          "start_evidence": {
            "type": "string"
          },
          "end_evidence": {
            "type": "string"
          },
          "activity": {
            "type": "string"
          },
          "billable": {
            "type": "boolean",
            "default": true
          },
          "override_reason": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "client_uuid": {
            "type": "string"
          }
        },
        "required": [
          "machine_id",
          "deployment_id",
          "operator_id",
          "start_at",
          "start_meter",
          "client_uuid"
        ]
      }
    }
  }
}
{
  "compilerOptions": {
    // Self-contained (no extends): Vercel uploads only this package's subtree,
    // so ../../tsconfig.base.json is absent on build machines (TS5083).
    // Values mirror the former extends target — keep in sync if the base changes.
    "target": "ES2022",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "rootDir": ".",
    "jsx": "preserve",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "baseUrl": ".",
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "isolatedModules": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.json",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "vitest.config.ts",
    // Dead scaffolding: not imported by any live module, so never compiled by
    // webpack. Excluded so typecheck/build gate only live code. Port or delete.
    "components/ui/questionnaire.tsx",
    "components/ui/data-table.tsx",
    "components/ui/pie-chart.tsx"
  ]
}

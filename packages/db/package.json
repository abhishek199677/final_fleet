{
  "name": "@fleetos/db",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "migrate": "node-pg-migrate up --migrations-dir migrations --database-url-env-var DATABASE_URL",
    "seed": "node seed.js",
    "lint": "node linters/migration-linter.js",
    "test:isolation": "DATABASE_URL=\"postgresql:///fleetos_test\" node generators/test-isolation.js fleetos_test",
    "test:finance": "DATABASE_URL=\"postgresql:///fleetos_test\" node generators/test-finance-denial.js fleetos_test",
    "test:append": "DATABASE_URL=\"postgresql:///fleetos_test\" node generators/test-append-only.js fleetos_test"
  },
  "dependencies": {
    "node-pg-migrate": "^7.8.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "typescript": "^5.7.0"
  }
}

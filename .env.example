# Fleet OS Environment Configuration
# Copy to .env and update values

# ─── Database ───
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fleetos
DB_USER=postgres
DB_PASSWORD=postgres

# ─── Auth ───
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRES_IN=24h

# ─── File Storage ───
# Use 'local' for dev, 's3' for production
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
EXPORT_DIR=./exports

# ─── S3 (when STORAGE_DRIVER=s3) ───
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET=fleetos-evidence-dev

# ─── API ───
API_PORT=3001

# ─── Web ───
NEXT_PUBLIC_API_URL=http://localhost:3001

# ─── Gemini API (free tier for OCR) ───
# Get free key at: https://aistudio.google.com/apikey
# 15 RPM, 1M tokens/day free
GEMINI_API_KEY=

# ─── WhatsApp (optional) ───
# WHATSAPP_API_KEY=
# WHATSAPP_PHONE_NUMBER_ID=

# ─── SMS (optional) ───
# SMS_API_KEY=
# SMS_PROVIDER=twilio

# ─── Feature Flags ───
# ENABLE_OCR=true
# ENABLE_WHATSAPP=false
# ENABLE_SMS=false
